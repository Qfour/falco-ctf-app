# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.code-workspace

# Secrets — never commit
.env
.env.*
*.key
*.pem
*.crt
kubeconfig*

# Local SQLite (scoreboard dev)
*.db
scoreboard/dev-data/

# Claude Code local-only
.claude/settings.local.json
.claude/last-test-commit

# Local Sysdig scanner output (dir and stray log file)
scan-logs

# Event production materials moved to falco-ctf-platform events/<date>/decks/
# (they embed real flags). Guard against re-creating them in this public repo.
challenges/decks/

# Claude Code agent worktrees (nested checkouts; never commit)
.claude/worktrees/

# Helm dependency build output (P21 item 5: charts/{scoreboard,auth-policy,
# collector} depend on charts/falco-ctf-common via a local file:// path dep).
# `helm dependency build` (see `make helm-dep-build`) regenerates both of
# these deterministically from the checked-in charts/falco-ctf-common
# source + each chart's Chart.yaml `dependencies:` pin — neither carries
# information that isn't already in git. Chart.lock's `generated:` field
# is a fresh timestamp on every run, so committing it would just be diff
# churn with no reproducibility benefit for a file:// (not registry) dep.
charts/*/charts/
charts/*/Chart.lock
