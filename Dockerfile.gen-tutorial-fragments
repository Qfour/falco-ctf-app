# Generates internal/scoreboard/view/tutorialfragments_gen.go from
# docs-site/docs/{index,cheatsheet}.md + docs-site/tutorial/*.md, per the
# content contract in docs-site/tutorial-chapters.yaml (P24). Mirrors
# Dockerfile.gen-home-fragments's shape (containerized codegen + scratch
# export stage) so it works without a local Go toolchain / under Colima (no
# host bind mounts shared into the VM by default).
#
# Usage:
#   docker build -f Dockerfile.gen-tutorial-fragments --target export -o . .
#   (or: make gen-tutorial-fragments)
#
# The generator itself (cmd/gen-tutorial-fragments, internal/homefragments)
# is the ONLY thing that imports goldmark / golang.org/x/net/html for THIS
# output — the scoreboard binary that serves GET /portal only go:embeds
# this command's committed output; it never parses markdown or sanitizes
# HTML at request time. See internal/homefragments's package doc for the
# full rationale (shared with gen-home-fragments).
FROM golang:1.26.9-alpine@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS gen
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/gen-tutorial-fragments/ ./cmd/gen-tutorial-fragments/
COPY internal/homefragments/ ./internal/homefragments/
# internal/homefragments imports the challenge-id grammar (app#437), a stdlib-only leaf.
COPY internal/catalog/challengeid/ ./internal/catalog/challengeid/
COPY internal/scoreboard/view/ ./internal/scoreboard/view/
COPY docs-site/docs/ ./docs-site/docs/
COPY docs-site/tutorial/ ./docs-site/tutorial/
RUN go run ./cmd/gen-tutorial-fragments /src

FROM scratch AS export
COPY --from=gen /src/internal/scoreboard/view/tutorialfragments_gen.go /internal/scoreboard/view/tutorialfragments_gen.go
