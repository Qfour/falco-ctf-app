# DUMMY cloud credential file for the 11-cloud-cred-hunt mission.
# Deployed to ~/.aws/credentials in the workspace so an attacker's on-disk
# credential hunt has something realistic to find. Values are NON-SECRET
# placeholders (AKIA...EXAMPLE is AWS's documented example key id) — this is a
# public repo; never put a real access key here.
[default]
aws_access_key_id = AKIAIOSFODNN7EXAMPLE
aws_secret_access_key = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
region = us-east-1

