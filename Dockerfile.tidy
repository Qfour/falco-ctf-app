# Generates go.mod / go.sum without needing a local Go toolchain or host
# bind mounts (Colima does not share the host repo path into its VM by
# default). Used by `make tidy`:
#
#   docker build -f Dockerfile.tidy --target export -o . .
#
# After running, the up-to-date go.mod and go.sum land in the repo root.
FROM golang:1.26-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS tidy
WORKDIR /src

COPY go.mod go.su[m] ./
COPY . .

RUN go mod tidy

# `scratch` lets `docker build -o .` extract files to the host.
FROM scratch AS export
COPY --from=tidy /src/go.mod /
COPY --from=tidy /src/go.sum /
