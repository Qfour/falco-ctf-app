<!-- ===== Board pane (app#292 QA Board, Phase 3): replaces P25's separate
     Support (participant own-tickets) and Queue (admin-only) panes with
     ONE tab everyone sees. Destination model (`internal/board`): every
     thread is created `audience: admin` (private — visible only to its
     own author and admins) or `audience: all` (public timeline, any
     authenticated participant may read + like it); audience is fixed at
     creation, there is no route that ever changes it, so "no destination
     change after posting" falls out of the API surface rather than
     needing its own client-side guard.
     A participant gets Compose + My Threads (every thread THEY authored,
     either audience) + Public Timeline (every `audience:all` thread, with
     like/unlike); an admin gets the moderation queue instead (every
     thread, both audiences, hidden/deleted included, reply +
     pin/answered/hide/delete). window.__PORTAL_ROLE__ does not change
     mid-session, so the branch below picks ONE of initParticipantView()/
     initAdminView() once at mount, mirroring how showTab()/applyRole()
     already treat that same global as session-stable elsewhere in this
     file — there is no code path that renders both.
     Polls at 5s, same cadence P25's Support/Queue used (this board is not
     expected to change faster than that); each view keeps its own
     `busy` flag scoped ONLY to the setInterval poll (falco-web skill: a
     write's own post-submit refresh must never be gated by the SAME flag
     that guards re-entrant polling, or a just-sent thread/reply/like
     would silently fail to appear) and its own signature-gated
     shell-vs-content split (R2 fixup pattern the retired Support/Queue
     panes established — rebuilding the whole page on every poll tick
     wipes in-progress drafts; repainting only the data subtree whose
     signature actually changed does not). ===== -->
<div class="pane p-shell" id="pane-board">

  <header>
    <div class="brand">
      <h1 class="p-h1"><span class="accent">Board</span></h1>
    </div>
    <div>
      <div class="live p-live">● LIVE</div>
      <div class="updated mono" id="pane-board-updated">connecting…</div>
    </div>
  </header>

  <div id="pane-board-page"></div>

<script nonce="{{.Nonce}}">
(function () {
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function fmtAgoISO(iso) {
    const ms = Date.now() - new Date(iso).getTime();
    const s = Math.max(0, Math.floor(ms / 1000));
    if (s < 5)    return 'just now';
    if (s < 60)   return s + 's ago';
    if (s < 3600) return Math.floor(s / 60) + 'm ago';
    if (s < 86400) return Math.floor(s / 3600) + 'h ago';
    return Math.floor(s / 86400) + 'd ago';
  }
  // bodyByteLen / MAX_BODY_BYTES (R2 fixup, review-5x of #165, carried
  // forward from the retired Support/Queue panes): the server's board
  // handlers (internal/scoreboard/api/board.go) count UTF-8 BYTES for
  // `body`, but a textarea's `maxlength` attribute counts UTF-16 code
  // units (JS string length) — a participant typing in a multi-byte
  // script (e.g. Japanese, ~3 bytes/char) can stay well under a
  // character-based maxlength yet still exceed 4096 BYTES server-side and
  // only discover it after clicking Send (server 400). Client-side
  // validation is therefore byte-based here, matching the server's own
  // unit, so the rejection happens before the round trip.
  const MAX_BODY_BYTES = 4096;
  function bodyByteLen(s) { return new TextEncoder().encode(s).length; }
  // Board `subject` is validated server-side by RUNE count, not bytes
  // (CreateThreadRequest's own doc: "1..120 runes after trimming") — a
  // different unit than `body`. `String.length` counts UTF-16 code units,
  // which over-counts a surrogate-pair (astral-plane, e.g. emoji)
  // character as 2; count Unicode code points via the spread operator
  // instead so the client-side cap matches the server's unit exactly.
  const MAX_SUBJECT_RUNES = 120;
  function runeLen(s) { return Array.from(s).length; }

  // Portal shell (P23-1): identity from the server-injected
  // __PORTAL_USER__/__PORTAL_ROLE__ globals, same convenience #pane-me
  // uses — every fetch below is independently re-gated server-side
  // (authenticated / admin / ownership checks inside internal/board), so
  // this is UI convenience only, never the authorization boundary.
  const user = window.__PORTAL_USER__ || '';
  const role = window.__PORTAL_ROLE__ || 'participant';
  const page = document.getElementById('pane-board-page');
  const updatedEl = document.getElementById('pane-board-updated');

  if (!user) {
    page.innerHTML = `
      <div class="help">
        <h2>Your username could not be determined</h2>
        <p>Ask the operator for your username, or reload the portal after logging in again.</p>
      </div>`;
    return;
  }

  if (role === 'admin') {
    initAdminView();
  } else {
    initParticipantView();
  }

  // ===== Participant view: Compose (destination picker) + My Threads +
  // Public Timeline (likes, sort). ===================================
  function initParticipantView() {
    // selectedTid selects which of the two views (list, vs one open
    // thread) is currently shown; null = list view.
    let selectedTid = null;
    let busy = false;
    // builtView tracks which SHELL is currently mounted in
    // #pane-board-page: 'list' (compose form + My Threads + Public
    // Timeline) or 'thread:<tid>' (an open thread). Only rebuilt when the
    // view actually changes, so the compose form and the append-message
    // textarea are never touched by a poll tick.
    let builtView = null;
    // Signature gates (falco-web skill), each scoped to ONLY its own
    // subtree — an unrelated thread's like_count ticking up in the
    // Public Timeline must not touch (or re-wire) the compose form a
    // participant may be mid-draft in.
    let lastMySig = null;
    let lastPublicSig = null;
    let lastDetailSig = null;
    // publicSort/lastThreadsRaw: GET /api/board/threads has no `?sort=`
    // (unlike the admin listing) — the Public Timeline sort toggle
    // re-orders the ALREADY-fetched array client-side, using the most
    // recent raw fetch so switching sort is instant (no round trip).
    let publicSort = 'recent';
    let lastThreadsRaw = [];
    // detailLiked/detailLikeCount back the open-thread Like button's
    // click handler — updated every content repaint (renderThreadContent)
    // so the handler (wired once at shell-mount time) always reads the
    // CURRENT like state via closure, never a value captured when the
    // shell was first built.
    let detailLiked = false;
    let detailLikeCount = 0;

    refresh();
    setInterval(() => { if (!busy) refresh(); }, 5000);

    async function refresh() {
      try {
        if (selectedTid) {
          await loadThread(selectedTid);
        } else {
          await loadList();
        }
        updatedEl.textContent = 'updated ' + new Date().toLocaleTimeString();
      } catch (e) {
        updatedEl.textContent = 'connection error';
      }
    }

    async function loadList() {
      const r = await fetch('/api/board/threads');
      // Stale-response guard: the participant may have opened a thread
      // while this GET was in flight — drop the result rather than
      // clobber their new view.
      if (selectedTid) return;
      if (!r.ok) throw new Error('HTTP ' + r.status);
      const d = await r.json();
      if (selectedTid) return;
      lastThreadsRaw = d.threads || [];
      renderList(lastThreadsRaw);
    }

    async function loadThread(tid) {
      const r = await fetch('/api/board/threads/' + encodeURIComponent(tid));
      if (selectedTid !== tid) return; // superseded by a newer navigation
      if (r.status === 404) {
        // Unknown id, another participant's private thread, or a
        // moderated-away thread all 404 identically (no existence
        // oracle) — either way it is not ours to view; bounce to the list.
        selectedTid = null;
        builtView = null;
        return loadList();
      }
      if (!r.ok) throw new Error('HTTP ' + r.status);
      const th = await r.json();
      if (selectedTid !== tid) return;
      renderThread(th);
    }

    function openThread(tid) {
      selectedTid = tid;
      loadThread(tid).catch(() => { updatedEl.textContent = 'connection error'; });
    }

    // renderList mounts the list SHELL (compose form + My Threads panel +
    // Public Timeline panel) at most once per visit to the list view —
    // the compose <input>/<textarea> and their submit listener are
    // created exactly once and never touched again by a poll tick.
    function renderList(threads) {
      if (builtView !== 'list') {
        page.innerHTML = `
          <section class="panel">
            <div class="panel-header"><h2>New thread</h2></div>
            <form class="qa-form" id="board-new-form">
              <div class="dest-choice">
                <label class="dest-option checked" data-dest="admin">
                  <input type="radio" name="board-dest" value="admin" checked>
                  <span class="dest-label">🔒 運営だけに送る (非公開)</span>
                  <div class="dest-guide">ミッションの解き方についての質問はこちら。あなたと運営だけが読めます。</div>
                </label>
                <label class="dest-option" data-dest="all">
                  <input type="radio" name="board-dest" value="all">
                  <span class="dest-label">🌐 全員に公開 (Public)</span>
                  <div class="dest-guide">ターミナル操作・環境トラブル・一般的な Falco/Linux の質問はこちら。全参加者に公開されます。flag 値や解答手順は書かないでください。</div>
                </label>
              </div>
              <input type="text" id="board-new-subject" placeholder="Subject" maxlength="120" autocomplete="off">
              <textarea id="board-new-body" placeholder="質問の内容を書いてください…" rows="4" maxlength="4096"></textarea>
              <button type="submit" class="btn">Send</button>
              <div class="submit-msg" id="board-new-msg"></div>
            </form>
          </section>
          <section class="panel">
            <div class="panel-header"><h2>My Threads</h2><span class="panel-aux" id="board-my-count"></span></div>
            <div id="board-my-list-wrap"></div>
          </section>
          <section class="panel">
            <div class="panel-header">
              <h2>Public Timeline</h2>
              <div class="sort-toggle">
                <button type="button" class="btn btn-sm" data-sort="recent">Recent</button>
                <button type="button" class="btn btn-sm" data-sort="likes">Likes</button>
              </div>
            </div>
            <div id="board-public-list-wrap"></div>
          </section>
        `;
        const form = document.getElementById('board-new-form');
        if (form) {
          form.addEventListener('submit', onCreateSubmit);
          form.querySelectorAll('input[name="board-dest"]').forEach(r => {
            r.addEventListener('change', updateDestChecked);
          });
        }
        page.querySelectorAll('.sort-toggle .btn').forEach(b => {
          b.addEventListener('click', () => {
            publicSort = b.getAttribute('data-sort');
            lastPublicSig = null; // force a repaint under the new order
            renderPublicListContent(lastThreadsRaw);
            updateSortButtons();
          });
        });
        updateSortButtons();
        builtView = 'list';
        lastMySig = null; // force the content paint below on this fresh mount
        lastPublicSig = null;
      }
      renderMyListContent(threads);
      renderPublicListContent(threads);
    }

    function updateDestChecked() {
      document.querySelectorAll('#board-new-form .dest-option').forEach(opt => {
        const input = opt.querySelector('input[type="radio"]');
        opt.classList.toggle('checked', !!(input && input.checked));
      });
    }

    function updateSortButtons() {
      document.querySelectorAll('#pane-board-page .sort-toggle .btn').forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-sort') === publicSort);
      });
    }

    // sortPublic re-orders a COPY (never mutates the fetched array) —
    // pinned threads always float to the top regardless of sort choice,
    // matching the server's own "pinned-first" default ordering; the two
    // sequential .sort() calls rely on Array.prototype.sort being stable
    // (modern engines) so the pinned re-sort preserves each group's
    // internal recent/likes order from the first pass.
    function sortPublic(arr) {
      const copy = arr.slice();
      if (publicSort === 'likes') {
        copy.sort((a, b) => (b.like_count - a.like_count) || (new Date(b.updated_at) - new Date(a.updated_at)));
      } else {
        copy.sort((a, b) => new Date(b.updated_at) - new Date(a.updated_at));
      }
      copy.sort((a, b) => (b.pinned === a.pinned) ? 0 : (b.pinned ? 1 : -1));
      return copy;
    }

    // renderMyListContent repaints ONLY the My Threads <ul> (+ count) —
    // every thread THIS caller authored, admin-destined or public alike.
    function renderMyListContent(threads) {
      const mine = threads.filter(t => t.author === user);
      const sig = 'my:' + JSON.stringify(mine);
      if (sig === lastMySig) return;
      lastMySig = sig;
      document.getElementById('board-my-count').textContent = mine.length;
      const wrap = document.getElementById('board-my-list-wrap');
      wrap.innerHTML = mine.length === 0
        ? '<div class="empty"><span class="icon">∅</span>No threads yet — ask something above.</div>'
        : '<ul class="ticket-list">' + mine.map(t => `
            <li>
              <button type="button" class="ticket-open" data-tid="${esc(t.id)}">
                <span class="subject">${t.pinned ? '<span class="badge pinned">Pinned</span> ' : ''}${esc(t.subject)}</span>
                <span class="meta">
                  <span class="badge ${t.audience === 'admin' ? 'private' : 'public'}">${t.audience === 'admin' ? 'Private' : 'Public'}</span>
                  <span class="badge ${t.answered ? 'answered' : 'pending'}">${t.answered ? 'Answered' : 'Awaiting reply'}</span>
                  <span>${t.message_count} msg${t.message_count === 1 ? '' : 's'} · ${fmtAgoISO(t.updated_at)}</span>
                </span>
              </button>
            </li>`).join('') + '</ul>';
      wrap.querySelectorAll('.ticket-open').forEach(btn => {
        btn.addEventListener('click', () => openThread(btn.getAttribute('data-tid')));
      });
    }

    // renderPublicListContent repaints ONLY the Public Timeline <ul> —
    // every `audience:all` thread (including the caller's own). The Like
    // button sits OUTSIDE the .ticket-open button (a <button> cannot
    // nest another <button> per the HTML spec) as a sibling in a flex
    // `.ticket-row`; the caller's OWN public thread shows a static heart
    // count instead of a Like button (self-like 409s server-side — the
    // UI simply never offers the affordance).
    function renderPublicListContent(threads) {
      const pub = sortPublic(threads.filter(t => t.audience === 'all'));
      const sig = 'public:' + publicSort + ':' + JSON.stringify(pub);
      if (sig === lastPublicSig) return;
      lastPublicSig = sig;
      const wrap = document.getElementById('board-public-list-wrap');
      wrap.innerHTML = pub.length === 0
        ? '<div class="empty"><span class="icon">∅</span>No public threads yet.</div>'
        : '<ul class="ticket-list">' + pub.map(t => {
            const who = esc(t.authorDisplay || t.author || '');
            const canLike = t.author !== user;
            const likeEl = canLike
              ? `<button type="button" class="btn btn-sm like-btn${t.liked ? ' liked' : ''}" data-tid="${esc(t.id)}" data-liked="${t.liked ? '1' : '0'}">♥ ${t.like_count}</button>`
              : `<span class="panel-aux like-static">♥ ${t.like_count}</span>`;
            return `
            <li class="ticket-row">
              <button type="button" class="ticket-open" data-tid="${esc(t.id)}">
                <span class="subject">${t.pinned ? '<span class="badge pinned">Pinned</span> ' : ''}${esc(t.subject)} <span class="who">— ${who}</span></span>
                <span class="meta">
                  <span class="badge ${t.answered ? 'answered' : 'pending'}">${t.answered ? 'Answered' : 'Awaiting reply'}</span>
                  <span>${fmtAgoISO(t.updated_at)}</span>
                </span>
              </button>
              ${likeEl}
            </li>`;
          }).join('') + '</ul>';
      wrap.querySelectorAll('.ticket-open').forEach(btn => {
        btn.addEventListener('click', () => openThread(btn.getAttribute('data-tid')));
      });
      wrap.querySelectorAll('.like-btn').forEach(btn => {
        btn.addEventListener('click', (ev) => {
          ev.stopPropagation();
          onToggleLike(btn.getAttribute('data-tid'), btn.getAttribute('data-liked') === '1');
        });
      });
    }

    async function onCreateSubmit(ev) {
      ev.preventDefault();
      const destEl = document.querySelector('#board-new-form input[name="board-dest"]:checked');
      const subjectEl = document.getElementById('board-new-subject');
      const bodyEl = document.getElementById('board-new-body');
      const msgEl = document.getElementById('board-new-msg');
      const audience = destEl ? destEl.value : 'admin';
      const subject = subjectEl.value.trim();
      const body = bodyEl.value.trim();
      if (!subject || !body) {
        msgEl.textContent = 'Subject and body are both required.';
        msgEl.className = 'submit-msg err';
        return;
      }
      if (runeLen(subject) > MAX_SUBJECT_RUNES) {
        msgEl.textContent = 'Subject too long (max ' + MAX_SUBJECT_RUNES + ' characters).';
        msgEl.className = 'submit-msg err';
        return;
      }
      if (bodyByteLen(body) > MAX_BODY_BYTES) {
        msgEl.textContent = 'Body too long (max ' + MAX_BODY_BYTES + ' bytes).';
        msgEl.className = 'submit-msg err';
        return;
      }
      busy = true;
      try {
        const r = await fetch('/api/board/threads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ audience, subject, body }),
        });
        if (r.status === 429) {
          msgEl.textContent = 'Please wait a few seconds before sending another thread.';
          msgEl.className = 'submit-msg err';
          return;
        }
        const d = await r.json().catch(() => ({}));
        if (!r.ok) {
          msgEl.textContent = d.error || ('Could not send (HTTP ' + r.status + ').');
          msgEl.className = 'submit-msg err';
          return;
        }
        // Reentrancy guard: only jump into the new thread if the
        // participant is still on the list view they submitted from.
        // Either way the new thread surfaces on the next list load
        // (the reset signatures force that).
        lastMySig = null;
        lastPublicSig = null;
        if (selectedTid === null) {
          selectedTid = d.id;
          renderThread(d);
        }
      } catch (e) {
        msgEl.textContent = 'Could not send — check your connection and try again.';
        msgEl.className = 'submit-msg err';
      } finally {
        busy = false;
      }
    }

    // renderThread mounts the thread SHELL (back button + message panel +
    // optional Like button + optional append-message form) at most once
    // per tid. The append-message form is shown ONLY on the caller's OWN
    // thread — this pane never renders a reply affordance on another
    // participant's thread (only an admin can reply; see initAdminView).
    function renderThread(th) {
      const shellKey = 'thread:' + th.id;
      const isOwn = th.author === user;
      const canLike = th.audience === 'all' && !isOwn;
      if (builtView !== shellKey) {
        page.innerHTML = `
          <button type="button" class="btn btn-back" id="board-detail-back">← Back to Board</button>
          <section class="panel">
            <div class="panel-header">
              <h2 id="board-detail-subject"></h2>
              <span id="board-detail-badges"></span>
            </div>
            <div class="thread-messages" id="board-detail-messages"></div>
            ${canLike ? '<div class="mod-actions"><button type="button" class="btn like-btn" id="board-detail-like"></button></div>' : ''}
          </section>
          ${isOwn ? `
          <section class="panel">
            <div class="panel-header"><h2>Add a message</h2></div>
            <form class="qa-form" id="board-append-form">
              <textarea id="board-append-body" placeholder="Add more detail…" rows="3" maxlength="4096"></textarea>
              <button type="submit" class="btn">Send</button>
              <div class="submit-msg" id="board-append-msg"></div>
            </form>
          </section>` : ''}
        `;
        const back = document.getElementById('board-detail-back');
        if (back) back.addEventListener('click', () => {
          selectedTid = null;
          builtView = null;
          loadList().catch(() => { updatedEl.textContent = 'connection error'; });
        });
        const appendForm = document.getElementById('board-append-form');
        if (appendForm) appendForm.addEventListener('submit', (ev) => onAppendSubmit(ev, th.id));
        const likeBtn = document.getElementById('board-detail-like');
        // likeBtn's handler reads detailLiked via closure at CLICK time,
        // not the value captured here at shell-mount time — see the
        // detailLiked/detailLikeCount doc up top.
        if (likeBtn) likeBtn.addEventListener('click', () => onToggleLike(th.id, detailLiked));
        builtView = shellKey;
        lastDetailSig = null; // force the content paint below on this fresh mount
      }
      renderThreadContent(th);
    }

    // renderThreadContent repaints ONLY the subject/badges/message list
    // (+ the Like button's label/state) — never the sibling append-message
    // form — gated by a signature of the thread data.
    function renderThreadContent(th) {
      const sig = 'thread-content:' + JSON.stringify(th);
      if (sig === lastDetailSig) return;
      lastDetailSig = sig;
      const who = esc(th.authorDisplay || th.author || '');
      document.getElementById('board-detail-subject').innerHTML =
        esc(th.subject) + (th.author !== user ? ' <span class="who">— ' + who + '</span>' : '');
      document.getElementById('board-detail-badges').innerHTML =
        (th.pinned ? '<span class="badge pinned">Pinned</span> ' : '') +
        '<span class="badge ' + (th.audience === 'admin' ? 'private' : 'public') + '">' + (th.audience === 'admin' ? 'Private' : 'Public') + '</span> ' +
        '<span class="badge ' + (th.answered ? 'answered' : 'pending') + '">' + (th.answered ? 'Answered' : 'Awaiting reply') + '</span>';
      document.getElementById('board-detail-messages').innerHTML = (th.messages || []).map(m => `
        <div class="thread-msg role-${m.author_role === 'admin' ? 'admin' : 'participant'}">
          <div class="thread-msg-head">
            <span class="thread-msg-author">${m.author_role === 'admin' ? 'Operator' : (m.author === user ? 'You' : esc(m.authorDisplay || m.author))}</span>
            <span class="thread-msg-at" title="${esc(m.created_at)}">${fmtAgoISO(m.created_at)}</span>
          </div>
          <div class="thread-msg-body">${m.state === 'deleted' ? '(message removed)' : esc(m.body)}</div>
        </div>`).join('');
      detailLiked = !!th.liked;
      detailLikeCount = th.like_count || 0;
      const likeBtn = document.getElementById('board-detail-like');
      if (likeBtn) {
        likeBtn.classList.toggle('liked', detailLiked);
        likeBtn.textContent = (detailLiked ? '♥ Liked ' : '♥ Like ') + detailLikeCount;
      }
    }

    async function onAppendSubmit(ev, tid) {
      ev.preventDefault();
      const bodyEl = document.getElementById('board-append-body');
      const msgEl = document.getElementById('board-append-msg');
      const body = bodyEl.value.trim();
      if (!body) {
        msgEl.textContent = 'Message required.';
        msgEl.className = 'submit-msg err';
        return;
      }
      if (bodyByteLen(body) > MAX_BODY_BYTES) {
        msgEl.textContent = 'Body too long (max ' + MAX_BODY_BYTES + ' bytes).';
        msgEl.className = 'submit-msg err';
        return;
      }
      busy = true;
      try {
        const r = await fetch('/api/board/threads/' + encodeURIComponent(tid) + '/messages', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ body }),
        });
        if (r.status === 429) {
          msgEl.textContent = 'Please wait a few seconds before sending another message.';
          msgEl.className = 'submit-msg err';
          return;
        }
        const d = await r.json().catch(() => ({}));
        if (!r.ok) {
          msgEl.textContent = d.error || ('Could not send (HTTP ' + r.status + ').');
          msgEl.className = 'submit-msg err';
          return;
        }
        bodyEl.value = '';
        if (selectedTid === tid) renderThread(d);
      } catch (e) {
        msgEl.textContent = 'Could not send — check your connection and try again.';
        msgEl.className = 'submit-msg err';
      } finally {
        busy = false;
      }
    }

    // onToggleLike is shared by the Public Timeline's inline Like buttons
    // AND the open-thread Like button — `liked` is the state BEFORE this
    // click (so we know like vs unlike), read from the caller's own
    // closure/attribute at click time.
    async function onToggleLike(tid, liked) {
      try {
        const r = await fetch('/api/board/threads/' + encodeURIComponent(tid) + (liked ? '/unlike' : '/like'), { method: 'POST' });
        if (r.status === 429) {
          updatedEl.textContent = 'rate limited — try again in a moment';
          return;
        }
        if (r.status === 409) {
          // Self-like guard tripped (should be unreachable — the UI never
          // renders a Like affordance on the caller's own thread); no-op.
          return;
        }
        if (!r.ok) return;
        // Refresh whichever view is showing this thread's like state.
        if (selectedTid === tid) {
          await loadThread(tid);
        } else {
          lastPublicSig = null;
          await loadList();
        }
      } catch (e) {
        updatedEl.textContent = 'connection error';
      }
    }
  }

  // ===== Admin view: moderation queue — every thread, both audiences,
  // hidden/deleted included; reply + pin/answered/hide/delete. =========
  function initAdminView() {
    let selectedTid = null;
    let busy = false;
    let builtView = null;
    let lastListSig = null;
    let lastDetailSig = null;
    // adminSort drives the SERVER-side `?sort=` param (unlike the
    // participant view's client-side publicSort) — the admin listing
    // route (boardAdminListThreads) accepts it directly.
    let adminSort = 'recent';
    // currentTh backs the moderation buttons' click handlers (wired once
    // at shell-mount time) so they always act on the CURRENT thread state
    // — see renderThreadContent, which reassigns this on every repaint.
    let currentTh = null;

    refresh();
    setInterval(() => { if (!busy) refresh(); }, 5000);

    async function refresh() {
      try {
        if (selectedTid) {
          await loadThread(selectedTid);
        } else {
          await loadList();
        }
        updatedEl.textContent = 'updated ' + new Date().toLocaleTimeString();
      } catch (e) {
        updatedEl.textContent = 'connection error';
      }
    }

    async function loadList() {
      const r = await fetch('/api/admin/board/threads?sort=' + encodeURIComponent(adminSort));
      if (selectedTid) return;
      if (!r.ok) throw new Error('HTTP ' + r.status);
      const d = await r.json();
      if (selectedTid) return;
      renderList(d.threads || []);
    }

    async function loadThread(tid) {
      const r = await fetch('/api/admin/board/threads/' + encodeURIComponent(tid));
      if (selectedTid !== tid) return;
      if (r.status === 404) {
        selectedTid = null;
        builtView = null;
        return loadList();
      }
      if (!r.ok) throw new Error('HTTP ' + r.status);
      const th = await r.json();
      if (selectedTid !== tid) return;
      renderThread(th);
    }

    function renderList(threads) {
      if (builtView !== 'list') {
        page.innerHTML = `
          <section class="panel">
            <div class="panel-header">
              <h2>All threads</h2>
              <span class="panel-aux" id="board-admin-count"></span>
              <div class="sort-toggle">
                <button type="button" class="btn btn-sm" data-sort="recent">Recent</button>
                <button type="button" class="btn btn-sm" data-sort="likes">Likes</button>
              </div>
            </div>
            <div id="board-admin-list-wrap"></div>
          </section>
        `;
        page.querySelectorAll('.sort-toggle .btn').forEach(b => {
          b.addEventListener('click', () => {
            adminSort = b.getAttribute('data-sort');
            updateSortButtons();
            lastListSig = null;
            loadList().catch(() => { updatedEl.textContent = 'connection error'; });
          });
        });
        updateSortButtons();
        builtView = 'list';
        lastListSig = null; // force the content paint below on this fresh mount
      }
      renderListContent(threads);
    }

    function updateSortButtons() {
      document.querySelectorAll('#pane-board-page .sort-toggle .btn').forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-sort') === adminSort);
      });
    }

    function renderListContent(threads) {
      const sig = 'list:' + JSON.stringify(threads);
      if (sig === lastListSig) return;
      lastListSig = sig;
      document.getElementById('board-admin-count').textContent = threads.length;
      const wrap = document.getElementById('board-admin-list-wrap');
      wrap.innerHTML = threads.length === 0
        ? '<div class="empty"><span class="icon">∅</span>No QA Board threads yet.</div>'
        : '<ul class="ticket-list">' + threads.map(t => `
            <li>
              <button type="button" class="ticket-open" data-tid="${esc(t.id)}">
                <span class="subject">${t.pinned ? '<span class="badge pinned">Pinned</span> ' : ''}${esc(t.subject)} <span class="who">— ${esc(t.authorDisplay || t.author || '')}</span></span>
                <span class="meta">
                  <span class="badge ${t.audience === 'admin' ? 'private' : 'public'}">${t.audience === 'admin' ? 'Private' : 'Public'}</span>
                  <span class="badge ${t.answered ? 'answered' : 'pending'}">${t.answered ? 'Answered' : 'Awaiting reply'}</span>
                  ${t.state !== 'visible' ? `<span class="badge ${esc(t.state)}">${esc(t.state)}</span>` : ''}
                  <span>♥ ${t.like_count} · ${t.message_count} msg${t.message_count === 1 ? '' : 's'} · ${fmtAgoISO(t.updated_at)}</span>
                </span>
              </button>
            </li>`).join('') + '</ul>';
      wrap.querySelectorAll('.ticket-open').forEach(btn => {
        btn.addEventListener('click', () => {
          selectedTid = btn.getAttribute('data-tid');
          loadThread(selectedTid).catch(() => { updatedEl.textContent = 'connection error'; });
        });
      });
    }

    // renderThread mounts the thread SHELL (back button + message panel +
    // moderation buttons + reply form) at most once per tid — re-polling
    // the SAME open thread must not touch the Reply textarea an operator
    // may be mid-draft in. The moderation buttons are part of this SAME
    // static shell (never rebuilt via innerHTML on a content-only
    // repaint) so their click listeners, wired once here, survive every
    // poll tick — only their LABEL text is updated per repaint, in
    // renderThreadContent below.
    function renderThread(th) {
      const shellKey = 'thread:' + th.id;
      if (builtView !== shellKey) {
        page.innerHTML = `
          <button type="button" class="btn btn-back" id="board-admin-back">← Back to all threads</button>
          <section class="panel">
            <div class="panel-header">
              <h2 id="board-admin-subject"></h2>
              <span id="board-admin-badges"></span>
            </div>
            <div class="thread-messages" id="board-admin-messages"></div>
            <div class="mod-actions">
              <button type="button" class="btn btn-sm" id="board-admin-pin"></button>
              <button type="button" class="btn btn-sm" id="board-admin-answered"></button>
              <button type="button" class="btn btn-sm" id="board-admin-hide"></button>
              <button type="button" class="btn btn-sm btn-danger" id="board-admin-delete">Delete</button>
            </div>
          </section>
          <section class="panel">
            <div class="panel-header"><h2>Reply</h2></div>
            <form class="qa-form" id="board-admin-reply-form">
              <textarea id="board-admin-reply-body" placeholder="Write a reply to this participant…" rows="3" maxlength="4096"></textarea>
              <button type="submit" class="btn">Send reply</button>
              <div class="submit-msg" id="board-admin-reply-msg"></div>
            </form>
          </section>
        `;
        const back = document.getElementById('board-admin-back');
        if (back) back.addEventListener('click', () => {
          selectedTid = null;
          builtView = null;
          loadList().catch(() => { updatedEl.textContent = 'connection error'; });
        });
        const replyForm = document.getElementById('board-admin-reply-form');
        if (replyForm) replyForm.addEventListener('submit', (ev) => onReplySubmit(ev, th.id));
        document.getElementById('board-admin-pin').addEventListener('click', () => onModerate({ pinned: !currentTh.pinned }));
        document.getElementById('board-admin-answered').addEventListener('click', () => onModerate({ answered: !currentTh.answered }));
        document.getElementById('board-admin-hide').addEventListener('click', () => onModerate({ state: currentTh.state === 'hidden' ? 'visible' : 'hidden' }));
        document.getElementById('board-admin-delete').addEventListener('click', () => {
          // Destructive-action confirm (falco-web skill): the confirm
          // text spells out the actual side effect (body scrub for
          // everyone, not just "delete") since that is more destructive
          // than the word "Delete" alone implies.
          if (!confirm('Delete this thread? Every message body is scrubbed for everyone, including admins, and this cannot be undone.')) return;
          onModerate({ state: 'deleted' });
        });
        builtView = shellKey;
        lastDetailSig = null; // force the content paint below on this fresh mount
      }
      renderThreadContent(th);
    }

    function renderThreadContent(th) {
      const sig = 'thread-content:' + JSON.stringify(th);
      if (sig === lastDetailSig) return;
      lastDetailSig = sig;
      currentTh = th;
      document.getElementById('board-admin-subject').innerHTML = esc(th.subject) + ' <span class="who">— ' + esc(th.authorDisplay || th.author) + '</span>';
      document.getElementById('board-admin-badges').innerHTML =
        (th.pinned ? '<span class="badge pinned">Pinned</span> ' : '') +
        '<span class="badge ' + (th.audience === 'admin' ? 'private' : 'public') + '">' + (th.audience === 'admin' ? 'Private' : 'Public') + '</span> ' +
        '<span class="badge ' + (th.answered ? 'answered' : 'pending') + '">' + (th.answered ? 'Answered' : 'Awaiting reply') + '</span>' +
        (th.state !== 'visible' ? ' <span class="badge ' + esc(th.state) + '">' + esc(th.state) + '</span>' : '');
      document.getElementById('board-admin-messages').innerHTML = (th.messages || []).map(m => `
        <div class="thread-msg role-${m.author_role === 'admin' ? 'admin' : 'participant'}">
          <div class="thread-msg-head">
            <span class="thread-msg-author">${m.author_role === 'admin' ? 'Operator' : esc(m.authorDisplay || m.author)}</span>
            <span class="thread-msg-at" title="${esc(m.created_at)}">${fmtAgoISO(m.created_at)}${m.state !== 'visible' ? ' · ' + esc(m.state) : ''}</span>
          </div>
          <div class="thread-msg-body">${m.state === 'deleted' ? '(message removed)' : esc(m.body)}</div>
        </div>`).join('');
      document.getElementById('board-admin-pin').textContent = th.pinned ? 'Unpin' : 'Pin';
      document.getElementById('board-admin-answered').textContent = th.answered ? 'Mark unanswered' : 'Mark answered';
      document.getElementById('board-admin-hide').textContent = th.state === 'hidden' ? 'Unhide' : 'Hide';
    }

    async function onModerate(patch) {
      try {
        const r = await fetch('/api/admin/board/threads/' + encodeURIComponent(currentTh.id) + '/state', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(patch),
        });
        if (!r.ok) throw new Error('HTTP ' + r.status);
        const d = await r.json();
        if (selectedTid === d.id) renderThread(d);
        lastListSig = null; // force the moderation-queue list to repaint next poll
      } catch (e) {
        updatedEl.textContent = 'connection error';
      }
    }

    async function onReplySubmit(ev, tid) {
      ev.preventDefault();
      const bodyEl = document.getElementById('board-admin-reply-body');
      const msgEl = document.getElementById('board-admin-reply-msg');
      const body = bodyEl.value.trim();
      if (!body) {
        msgEl.textContent = 'Reply text required.';
        msgEl.className = 'submit-msg err';
        return;
      }
      if (bodyByteLen(body) > MAX_BODY_BYTES) {
        msgEl.textContent = 'Body too long (max ' + MAX_BODY_BYTES + ' bytes).';
        msgEl.className = 'submit-msg err';
        return;
      }
      busy = true;
      try {
        const r = await fetch('/api/admin/board/threads/' + encodeURIComponent(tid) + '/reply', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ body }),
        });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) {
          msgEl.textContent = d.error || ('Could not send (HTTP ' + r.status + ').');
          msgEl.className = 'submit-msg err';
          return;
        }
        // The shell (this SAME reply form) stays mounted across a
        // same-tid repaint, so clear the textarea explicitly rather than
        // relying on a full-page rebuild to do it.
        bodyEl.value = '';
        if (selectedTid === tid) renderThread(d);
      } catch (e) {
        msgEl.textContent = 'Could not send — check your connection and try again.';
        msgEl.className = 'submit-msg err';
      } finally {
        busy = false;
      }
    }
  }
})();
</script>

</div>
