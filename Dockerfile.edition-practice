# Renders the practice edition of one investigate challenge (ADR-0056 D20 `edition render
# --practice`, D19 A4e-3b) without a Go toolchain on the host and without bind mounts (Colima
# does not share the host repo path into its VM by default). Used by `make edition-practice`:
#
#   docker build -f Dockerfile.edition-practice --target export --build-arg CID=<cid> -o <dir> .
#
# The export stage holds /challenges/<cid>/edition/practice/ only: the Makefile puts it in place
# of the host's challenges/<cid>/edition/practice/ (and commits nothing). It is NOT one of the I5
# images: it is never pushed, is not in the Makefile's IMAGES, and its only output is files.
#
# Stages
#   build   the base of Dockerfile.test (the same golang image, pinned by digest) and its module
#           cache (`go mod download`, the one step that reaches the network), then the scoreboard
#           binary, built as scoreboard/Dockerfile builds it, with no network
#   render  `scoreboard edition render --practice` on the build context's challenges/, with no
#           network: it replaces challenges/<cid>/edition/practice/ inside this stage
#   export  scratch with that practice/ only
FROM golang:1.26.11-alpine@sha256:ae52b5bc6ed045a9ed26ab03dc19327a802a9cc9aa8b27ed57f5c6b60579b0bb AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/scoreboard ./cmd/scoreboard
COPY internal ./internal

RUN --network=none CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/scoreboard ./cmd/scoreboard

FROM build AS render
# The challenge id is checked here (an early, readable error) and again by the command, which
# refuses an id outside the grammar of internal/catalog/challengeid.
ARG CID
COPY challenges ./challenges
# The practice/ that COPY brought in is removed first: it sits in a lower image layer, and
# moving a lower-layer directory aside (the command's replace) fails on overlayfs with EXDEV
# (exit 3). The render here always writes a fresh practice/; the host's copy is replaced by
# the Makefile, which keeps the earlier one until the new one is in place.
RUN --network=none case "${CID}" in ''|*[!a-z0-9-]*) echo "error: CID=<challenge id> is required (the build-arg)" >&2; exit 2;; esac \
 && rm -rf "/src/challenges/${CID}/edition/practice" \
 && /out/scoreboard edition render --practice --challenges /src/challenges --cid "${CID}"

FROM scratch AS export
ARG CID
COPY --from=render /src/challenges/${CID}/edition/practice/ /challenges/${CID}/edition/practice/
