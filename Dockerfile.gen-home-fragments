# Generates internal/scoreboard/view/homefragments_gen.go from
# docs-site/docs/*.md + challenges/<NN>-<slug>/rule-explain.md, per the
# content contract in docs-site/home-fragments.yaml (P23-5). Mirrors
# Dockerfile.gen's shape (containerized codegen + scratch export stage) so
# it works without a local Go toolchain / under Colima (no host bind mounts
# shared into the VM by default).
#
# Usage:
#   docker build -f Dockerfile.gen-home-fragments --target export -o . .
#   (or: make gen-home-fragments)
#
# The generator itself (cmd/gen-home-fragments, internal/homefragments) is
# the ONLY thing that imports goldmark / golang.org/x/net/html — the
# scoreboard binary that serves GET /portal only go:embeds this command's
# committed output; it never parses markdown or sanitizes HTML at request
# time. See internal/homefragments's package doc for the full rationale.
FROM golang:1.26.9-alpine@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS gen
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/gen-home-fragments/ ./cmd/gen-home-fragments/
COPY internal/homefragments/ ./internal/homefragments/
# internal/homefragments imports the challenge-id grammar (app#437), a stdlib-only leaf.
COPY internal/catalog/challengeid/ ./internal/catalog/challengeid/
COPY internal/scoreboard/view/ ./internal/scoreboard/view/
COPY docs-site/docs/ ./docs-site/docs/
COPY challenges/ ./challenges/
RUN go run ./cmd/gen-home-fragments /src

FROM scratch AS export
COPY --from=gen /src/internal/scoreboard/view/homefragments_gen.go /internal/scoreboard/view/homefragments_gen.go
